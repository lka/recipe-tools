#!/bin/bash
set -e

PYTHON="venv/Scripts/python"

echo "--- Formatierung (black) ---"
"$PYTHON" -m black src/ tests/
if ! git diff --quiet; then
    echo "black hat Formatierungen vorgenommen. Bitte die Änderungen stagen und committen."
    exit 1
fi

echo "--- Linting (flake8) ---"
"$PYTHON" -m flake8 src/ tests/

echo "--- Tests ---"
"$PYTHON" -m pytest
